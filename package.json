{
  "name": "dentvitalis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:ensure": "bash scripts/ensure-preview.sh",
    "reference:audit": "node scripts/audit-webflow.mjs",
    "reference:audit-live": "xvfb-run -a node scripts/audit-live-site.mjs",
    "audit:copy:it": "node scripts/audit-italian-copy.mjs",
    "audit:urls": "node scripts/audit-url-inventory.mjs",
    "proposal:redirects": "node scripts/redirect-proposal.mjs",
    "audit:redirects": "node scripts/audit-redirect-targets.mjs",
    "test:redirects": "node --test scripts/redirect-proposal.test.mjs",
    "content:extract:hr": "python3 scripts/extract-translation-source.py",
    "content:check:hr": "python3 scripts/extract-translation-source.py --check",
    "content:extract:hr-legal": "node scripts/extract-hr-legal.mjs",
    "test:hr": "playwright test tests/croatian.spec.ts --workers 2",
    "test:content": "node --test scripts/content-source.test.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "playwright test",
    "test:preview": "node --test scripts/ensure-preview.test.mjs",
    "validate": "npm run check && npm run lint && npm run format:check && npm run test:content && npm run test:redirects && npm run test:preview && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.2.10",
    "schema-dts": "2.0.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "packageManager": "npm@11.9.0"
}
