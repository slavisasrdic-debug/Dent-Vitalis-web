---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactWidgets from '../components/ContactWidgets.astro';
import RevealSetup from '../components/RevealSetup.astro';
import SEOHead from '../components/SEOHead.astro';
import FontStyles from '../components/FontStyles.astro';
import type { PageSEO } from '../content/seo';
import * as hr from '../content/hr/site';
import { equivalentLanguages } from '../content/hr/routes';
import { ui } from '../content/ui';
import {
  clinic,
  chatCopy,
  languages,
  navigation,
  navigationLinks,
  footerGroups,
} from '../content/site';
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  pageLanguages?: typeof languages;
  typography?: 'brand' | 'reference-default';
  seo?: PageSEO;
}
const {
  title,
  description,
  lang = 'it',
  canonical = 'https://www.dentvitalis.com/',
  pageLanguages = equivalentLanguages(new URL(canonical).pathname),
  typography = 'brand',
  seo,
} = Astro.props;
const localized =
  lang === 'hr'
    ? hr
    : { clinic, chatCopy, navigation, navigationLinks, footerGroups };
const copy = ui(lang);
---

<!doctype html>
<html lang={lang}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><slot name="head" /><FontStyles /><RevealSetup /><SEOHead
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      languages={pageLanguages}
      seo={seo}
    /></head
  >
  <body class:list={{ 'reference-default': typography === 'reference-default' }}
    ><a class="skip-link" href="#main">{copy.skip}</a><Header
      groups={localized.navigation}
      links={localized.navigationLinks}
      languages={pageLanguages}
      lang={lang}
      tagline={localized.clinic.tagline}
      consultation={localized.clinic.consultation}
      request={localized.clinic.menuRequest}
    /><main id="main"><slot /></main><Footer
      business={localized.clinic}
      groups={localized.footerGroups}
      lang={lang}
    /><ContactWidgets
      consultation={localized.clinic.consultation}
      whatsapp={localized.clinic.whatsapp}
      content={localized.chatCopy}
      lang={lang}
    /><script>
      import { initializeReveals } from '../scripts/reveal';
      initializeReveals();
    </script></body
  >
</html>
