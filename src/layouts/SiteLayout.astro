---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactWidgets from '../components/ContactWidgets.astro';
import RevealSetup from '../components/RevealSetup.astro';
import footerGroups from '../content/footer-it.json';
import {
  clinic,
  chatCopy,
  languages,
  navigation,
  navigationLinks,
} from '../content/site';
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  pageLanguages?: typeof languages;
  typography?: 'brand' | 'reference-default';
}
const {
  title,
  description,
  lang = 'it',
  canonical = 'https://www.dentvitalis.com/',
  pageLanguages = languages,
  typography = 'brand',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><RevealSetup /><title>{title}</title><meta
      name="description"
      content={description}
    /><meta name="robots" content="noindex, nofollow" /><link
      rel="canonical"
      href={canonical}
    /><link rel="alternate" hreflang="it" href={canonical} /><link
      rel="alternate"
      hreflang="x-default"
      href="https://www.dentvitalis.com/"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" /><meta
      property="og:url"
      content={canonical}
    /><slot name="head" /></head
  >
  <body class:list={{ 'reference-default': typography === 'reference-default' }}
    ><a class="skip-link" href="#main">Vai al contenuto</a><Header
      groups={navigation}
      links={navigationLinks}
      languages={pageLanguages}
      lang={lang}
      tagline={clinic.tagline}
      consultation={clinic.consultation}
      request={clinic.menuRequest}
    /><main id="main"><slot /></main><Footer
      business={clinic}
      groups={footerGroups}
    /><ContactWidgets
      consultation={clinic.consultation}
      whatsapp={clinic.whatsapp}
      content={chatCopy}
    /><script>
      import { initializeReveals } from '../scripts/reveal';
      initializeReveals();
    </script></body
  >
</html>
