---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Hero from '../../components/home/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TeaserSequence from '../../components/home/TeaserSequence.astro';
import ContactSection from '../../components/ContactSection.astro';
import { clinic } from '../../content/site';
import { equivalentLanguages } from '../../content/hr/routes';
import type { TeaserCardData } from '../../content/home';
import { contactCopy as contact, row, navigation } from '../../content/de/site';

type CardMedia = Pick<
  TeaserCardData,
  'href' | 'desktopImage' | 'mobileImage' | 'alt'
>;
const serviceAssets: CardMedia[] = [
  {
    href: '/de/four-implant-denture',
    desktopImage: 'Sedazione-cosciente-1.webp',
    mobileImage: 'Sedazione-cosciente-mobile.webp',
    alt: 'Patient während einer Behandlung mit bewusster Sedierung',
  },
  {
    href: '/de/fixed-implant-bridge',
    desktopImage: 'ponte-fisso-su-impianti-2.webp',
    mobileImage: 'Dv-3.webp',
    alt: 'Patient während einer zahnmedizinischen Behandlung',
  },
  {
    href: '/de/whitening',
    desktopImage: 'Recenzija-detail-1.webp',
    mobileImage: 'Recenzija-mobile.jpg',
    alt: 'Zufriedene Patientin in der DentVitalis Klinik',
  },
  {
    href: '/de/crowns-veneers-bridges',
    desktopImage: 'Dv-4-2.webp',
    mobileImage: 'Dv-4-2.webp',
    alt: 'Patient während einer zahnmedizinischen Untersuchung',
  },
];
const aboutAssets: CardMedia[] = [
  {
    href: '/de/specialists',
    desktopImage: 'I-nostri-specialist-2i.webp',
    mobileImage: 'I-nostri-specialisti-mobile-2.webp',
    alt: 'DentVitalis Spezialisten in der Klinik',
  },
  {
    href: '/de/all-in-one',
    desktopImage: 'Tutto-in-un-unico-luogo-1.webp',
    mobileImage: 'DV-44.webp',
    alt: 'DentVitalis Team und Klinik',
  },
  {
    href: '/de/directions',
    desktopImage: 'Come-raggiungerci.webp',
    mobileImage: 'Come-raggiungerci.webp',
    alt: 'Rijeka, Standort der DentVitalis Klinik',
  },
  {
    href: '/de/laboratory',
    desktopImage: 'Laboratorio-odontotecnico-1.webp',
    mobileImage: 'Laboratorio-odontotecnico-1.webp',
    alt: 'Dentallabor von DentVitalis',
  },
];
const services = serviceAssets.map((card, index) => {
  const [eyebrow, title, description, price] = row('t1', index + 2);
  return {
    ...card,
    eyebrow: eyebrow!,
    title: title!,
    description: description!,
    price: price!,
  };
});
const aboutCopy = row('t1', 7);
const about = aboutAssets.map((card, index) => ({
  ...card,
  title: aboutCopy[3 + index * 2]!,
  description: aboutCopy[4 + index * 2]!,
}));
const pageLanguages = equivalentLanguages('/de/');
const metadata = {
  title: 'DentVitalis – Zahnärzte in Kroatien',
  description:
    'Hochwertige Zahnmedizin und große Ersparnisse in der DentVitalis Klinik in Rijeka, Kroatien.',
};
---

<SiteLayout
  {...metadata}
  lang="de"
  canonical="https://www.dentvitalis.com/de/"
  pageLanguages={pageLanguages}
  seo={{}}
>
  <Hero
    price={clinic.premiumPrice}
    benefits={[
      'Festsitzende implantatgetragene Brücke',
      'Keine zusätzlichen Kosten',
      'Zinsfreie Kartenzahlung in bis zu 36 Raten',
      'Unterkunft in der Klinik',
      'Implantatpass der eingesetzten Implantate',
      'Schriftliche Garantie',
    ]}
    maps={clinic.maps}
    content={{
      eyebrowAccent: 'Premium-Paket',
      eyebrow: 'für eine festsitzende implantatgetragene Brücke',
      title: 'ein einzigartiges Angebot in Kroatien',
      pricePrefix: 'Festpreis von',
      priceText: '4.990 €',
      href: '/de/fixed-implant-bridge',
      cta: 'Mehr erfahren',
      ratingAlt: 'Google-Bewertung von DentVitalis',
    }}
  />
  <section class="intro-section">
    <SectionHeading
      eyebrow={row('t1', 1)[0]!}
      accent="Große Ersparnisse"
      title="und erstklassige Zahnmedizin an einem Ort"
      description={row('t1', 1)[2]!}
      variant="intro"
    />
  </section>
  <section id="leistungen">
    <TeaserSequence
      cards={services}
      variant="service"
      label="Dienstleistungen"
    />
  </section>
  <section id="ueber-uns">
    <SectionHeading
      eyebrow={aboutCopy[0]!}
      title={aboutCopy[1]!}
      description={aboutCopy[2]!}
    /><TeaserSequence cards={about} variant="about" label="Über uns" />
  </section>
  <section id="informationen" class="information-links">
    <h2>{row('t1', 9)[0]}</h2>
    <ul>
      {
        navigation[2]!.children.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
  <ContactSection content={contact} lang="de" />
</SiteLayout>
<style>
  .information-links {
    width: 90%;
    max-width: var(--container-max);
    margin: 80px auto;
  }
  .information-links h2 {
    color: var(--color-primary);
  }
  .information-links ul {
    display: grid;
    gap: 20px;
    padding-left: 24px;
  }
  .information-links a {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
