---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DetailHero from '../components/DetailHero.astro';
import ImagePreload from '../components/ImagePreload.astro';
import PhotoCardSequence from '../components/PhotoCardSequence.astro';
import ContactSection from '../components/ContactSection.astro';
import EditorialPage from '../components/EditorialPage.astro';
import { innerPages, type InnerPage } from '../content/inner-pages';
import { contactCopy } from '../content/site';
import { innerPagesHr } from '../content/hr/inner';
import { contactCopy as hrContactCopy } from '../content/hr/site';
import { equivalentLanguages } from '../content/hr/routes';
import { flatten, plain, type PageSEO } from '../content/seo';
import { referenceBusiness } from '../../data/site';
export function getStaticPaths() {
  return [...innerPages, ...innerPagesHr].map((page) => ({
    params: { path: page.route.slice(1) },
    props: { page },
  }));
}
interface Props {
  page: InnerPage;
}
const { page } = Astro.props;
const pageLanguages = equivalentLanguages(page.route);
const referenceRoute = page.referenceRoute ?? page.route;
// Approved metadata repair only; the legal source and visible article stay intact.
const isItalianLegal =
  page.lang === 'it' &&
  ['/condizioni-di-utilizzo', '/informativa-sulla-privacy'].includes(
    referenceRoute,
  );
const firstParagraph = isItalianLegal
  ? flatten(page.blocks).find((block) => block.type === 'paragraph')
  : undefined;
const title = isItalianLegal ? `${page.hero.title} | DentVitalis` : page.title;
const description =
  firstParagraph?.type === 'paragraph'
    ? (plain(firstParagraph.content).match(/^.*?[.!?](?=\s|$)/s)?.[0] ??
      plain(firstParagraph.content))
    : page.description;
const directory =
  referenceRoute === '/chi-siamo'
    ? 'about'
    : referenceRoute === '/prestazioni-dentali'
      ? 'services'
      : 'information';
const cards = page.directory.map((card) => ({
  ...card,
  desktopImage: card.desktop.image,
  mobileImage: card.mobile.image,
  alt: card.mobile.alt,
}));
const seo: PageSEO = {
  type:
    referenceRoute === '/contatti'
      ? 'ContactPage'
      : referenceRoute === '/chi-siamo'
        ? 'AboutPage'
        : referenceRoute === '/domande-e-risposte'
          ? 'ImageGallery'
          : page.directory.length || referenceRoute === '/testimonianze'
            ? 'CollectionPage'
            : 'WebPage',
  breadcrumb: page.breadcrumb,
  photo: page.hero.photo ?? page.directory[0]?.desktop,
  questions: flatten(page.blocks).flatMap((b) =>
    b.type === 'faq' ? [{ question: b.question, answer: plain(b.answer) }] : [],
  ),
};
if (referenceRoute === '/testimonianze')
  seo.videos = flatten(page.blocks).flatMap((b) =>
    b.type === 'youtube' ? [{ videoId: b.videoId, title: b.title }] : [],
  );
if (referenceRoute === '/su-di-noi/i-nostri-specialisti') {
  const blocks = flatten(page.blocks);
  seo.people = blocks.flatMap((block, i) => {
    if (block.type !== 'heading' || blocks[i + 1]?.type !== 'image') return [];
    const body = blocks.slice(i + 2).find((b) => b.type === 'paragraph');
    return [
      {
        name: plain(block.content),
        ...(body?.type === 'paragraph'
          ? { description: plain(body.content) }
          : {}),
      },
    ];
  });
}
if (referenceRoute.startsWith('/prestazioni/')) {
  const amount = referenceRoute.includes('protesi-definitiva')
    ? referenceBusiness.implantPrice
    : referenceRoute.includes('premium-ponte')
      ? referenceBusiness.premiumPrice
      : referenceRoute.includes('sbiancamento')
        ? referenceBusiness.whiteningPrice
        : undefined;
  seo.service = { name: page.hero.title, price: amount?.replaceAll('.', '') };
}
---

<SiteLayout
  title={title}
  description={description}
  typography={page.typography}
  canonical={`https://www.dentvitalis.com${page.route}`}
  pageLanguages={pageLanguages}
  lang={page.lang}
  seo={seo}
>
  <Fragment slot="head">
    {page.hero.photo && <ImagePreload image={page.hero.photo.image} />}
  </Fragment>
  <Breadcrumb items={page.breadcrumb} lang={page.lang} />
  <DetailHero content={page.hero} />
  {
    page.directory.length ? (
      <PhotoCardSequence
        cards={cards}
        variant="service"
        label={page.hero.title}
        directory={directory}
      />
    ) : (
      <EditorialPage page={page} />
    )
  }
  <ContactSection
    content={page.lang === 'hr' ? hrContactCopy : contactCopy}
    lang={page.lang}
  />
</SiteLayout>
