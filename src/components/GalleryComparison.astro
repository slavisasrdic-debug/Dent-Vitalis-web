---
import type { ContentPhoto } from '../content/inner-pages';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  before: ContentPhoto;
  after: ContentPhoto;
  beforeLabel: string;
  afterLabel: string;
}
const { before, after, beforeLabel, afterLabel } = Astro.props;
---

<div
  class="comparison"
  data-comparison
  data-before-label={beforeLabel}
  data-after-label={afterLabel}
  role="group"
  aria-label={`${beforeLabel} / ${afterLabel}`}
>
  <ResponsiveImage
    image={before.image}
    alt={before.alt}
    sizes="(min-width:992px) 55vw, 90vw"
  />
  <div class="after">
    <ResponsiveImage
      image={after.image}
      alt={after.alt}
      sizes="(min-width:992px) 55vw, 90vw"
    />
  </div>
  <input
    class="comparison-range"
    type="range"
    min="0"
    max="100"
    step="1"
    value="50"
    aria-label={`${beforeLabel} / ${afterLabel}: ${before.alt}`}
    disabled
  />
  <span class="handle" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path
        d="m9.75 6.5-5.5 5.5 5.5 5.5m4.5-11 5.5 5.5-5.5 5.5"
        stroke="#282735"
        stroke-width="2"></path>
    </svg>
  </span>
  <span class="line" aria-hidden="true"></span>
  <button
    class="label before-label"
    type="button"
    data-comparison-value="100"
    disabled>{beforeLabel}</button
  >
  <button
    class="label after-label"
    type="button"
    data-comparison-value="0"
    disabled>{afterLabel}</button
  >
</div>
<script>
  import { initializeComparisons } from '../scripts/comparison';
  initializeComparisons();
</script>
<style>
  .comparison {
    --comparison-position: 50%;
    --comparison-thumb: 42px;
    position: relative;
    width: 100%;
    max-width: 946px;
    aspect-ratio: 1.46;
    border: 8px solid white;
    border-radius: 12px;
    overflow: hidden;
  }
  .comparison :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--comparison-position));
  }
  .line {
    position: absolute;
    left: var(--comparison-position);
    top: 0;
    bottom: 0;
    width: 2px;
    background: white;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 1;
  }
  .handle {
    position: absolute;
    top: 50%;
    left: var(--comparison-position);
    transform: translate(-50%, -50%);
    width: var(--comparison-thumb);
    height: var(--comparison-thumb);
    background: white;
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 2;
  }
  .comparison:not([data-comparison-ready]) .handle {
    display: none;
  }
  .comparison-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    appearance: none;
    -webkit-appearance: none;
    cursor: ew-resize;
    touch-action: pan-y;
    z-index: 2;
  }
  .comparison-range::-webkit-slider-runnable-track {
    height: var(--comparison-thumb);
  }
  .comparison-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: var(--comparison-thumb);
    height: var(--comparison-thumb);
  }
  .comparison-range::-moz-range-thumb {
    width: var(--comparison-thumb);
    height: var(--comparison-thumb);
    border: 0;
  }
  .comparison-range:focus-visible + .handle {
    outline: 2px solid var(--color-primary);
    outline-offset: -3px;
  }
  [data-comparison-animate] .after {
    transition: clip-path var(--comparison-duration) var(--comparison-easing);
  }
  [data-comparison-animate] .handle,
  [data-comparison-animate] .line {
    transition: left var(--comparison-duration) var(--comparison-easing);
  }
  .label {
    position: absolute;
    top: 24px;
    background: white;
    color: #000;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 14px;
    line-height: 20px;
    font-weight: inherit;
    border: 0;
    z-index: 3;
    touch-action: manipulation;
  }
  .label::before {
    content: '';
    position: absolute;
    inset: -8px 0;
  }
  .label:disabled {
    color: #000;
    opacity: 1;
    cursor: default;
  }
  .before-label {
    left: 24px;
  }
  .after-label {
    right: 24px;
  }
  @media (prefers-reduced-motion: reduce) {
    .after,
    .handle,
    .line {
      transition: none !important;
    }
  }
</style>
