---
import Icon from './Icon.astro';
interface Props {
  href: string;
  label: string;
  variant?: 'more' | 'hero' | 'consultation' | 'outline' | 'menu';
  class?: string;
  inquiry?: boolean;
  reveal?: boolean;
}
const { href, label, variant = 'more', class: className } = Astro.props;
---

<a
  data-reveal={Astro.props.reveal ? 'grow' : undefined}
  data-delay={Astro.props.reveal ? 600 : undefined}
  data-offset={Astro.props.reveal ? 0 : undefined}
  href={href}
  class:list={['button', variant, className]}
  data-contact-trigger={variant === 'consultation' ||
    Astro.props.inquiry ||
    undefined}
>
  {variant === 'consultation' && <Icon name="calendar" />}
  <span class="label">{label}</span>
  {
    variant !== 'consultation' && variant !== 'menu' && (
      <span class="arrow">
        <Icon name="double-arrow" size={32} />
      </span>
    )
  }
</a>
<style>
  .button {
    display: grid;
    grid-template-columns: 3fr 1fr;
    align-items: center;
    min-width: 200px;
    height: 56px;
    padding-left: 30px;
    border-radius: 10px;
    background: var(--color-primary);
    color: white;
    font-size: 18px;
    font-weight: 600;
    line-height: 120%;
    position: relative;
  }
  .label {
    padding: 10px 30px 10px 0;
  }
  .arrow {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 20px;
    height: 100%;
  }
  .arrow::before {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    right: calc(100% + 6px);
    width: 1px;
    background: #ffffff80;
  }
  .hero {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .outline {
    background: white;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
  }
  .button:hover {
    background: var(--color-primary-hover);
  }
  .hero:hover,
  .hero:focus-visible,
  .outline:hover,
  .outline:focus-visible {
    background: var(--color-primary-hover);
    color: var(--color-white);
  }
  .consultation {
    display: flex;
    gap: 8px;
    justify-content: center;
    min-width: 80px;
    height: auto;
    padding: 10px 7px;
    border-radius: var(--radius);
    font-size: 12px;
    font-weight: 700;
  }
  .consultation .label {
    padding: 0;
  }
  @media screen and (min-width: 1440px) {
    .consultation {
      padding-inline: 1vw;
      gap: 10px;
      font-size: 14px;
    }
  }
  @media screen and (max-width: 991px) {
    .arrow::before {
      top: 7px;
      bottom: 7px;
    }
    .consultation {
      padding: 10px 20px;
      font-size: 16px;
      height: 56px;
      width: 100%;
    }
  }
  @media screen and (max-width: 479px) {
    .button:not(.consultation) {
      width: 100%;
      padding-left: 20px;
      height: auto;
      min-height: 56px;
    }
    .consultation {
      height: 48px;
      padding: 8px 12px;
    }
  }
  @media screen and (max-width: 479px) {
    .button:not(.consultation) {
      font-size: 16px;
    }
    .label {
      padding-right: 15px;
    }
  }
  .button.menu {
    display: inline-flex;
    width: auto;
    min-width: 0;
    min-height: 48px;
    height: 48px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 18px;
    line-height: 27px;
    font-weight: 700;
  }
  .menu .label {
    padding: 0;
  }
</style>
