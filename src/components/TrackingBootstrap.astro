---
const liveHosts = ['dentvitalis.com', 'www.dentvitalis.com'];
const gtmContainer = 'GTM-K3QGWS';
// CookieYes and Consent Mode are owned by the existing GTM container.
// Owner approved 2026-10-01: do not load the CMP separately here.
---

<script
  is:inline
  data-tracking-bootstrap
  define:vars={{ liveHosts, gtmContainer }}
>
  (() => {
    if (!liveHosts.includes(window.location.hostname.toLowerCase())) return;

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

    const firstScript = document.getElementsByTagName('script')[0];
    const gtm = document.createElement('script');
    gtm.async = true;
    gtm.src = `https://www.googletagmanager.com/gtm.js?id=${gtmContainer}`;
    firstScript.parentNode?.insertBefore(gtm, firstScript);
  })();
</script>
