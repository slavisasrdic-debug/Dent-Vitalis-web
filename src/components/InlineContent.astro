---
import type { InlineContent } from '../content/inner-pages';
import { contactLinks, correctContactTarget } from '../content/contact-links';
interface Props {
  content: InlineContent[];
  linkContacts?: boolean;
}
const { content, linkContacts = true } = Astro.props;
const parts = content
  .flatMap((part) =>
    linkContacts && part.kind === 'text' ? contactLinks(part.text) : [part],
  )
  .map(correctContactTarget);
---

{
  parts.map((part) =>
    part.kind === 'text' ? (
      part.text
    ) : part.kind === 'break' ? (
      <br />
    ) : part.kind === 'link' ? (
      <a
        href={part.href}
        class={part.variant}
        data-contact-link={part.variant === 'contact' || undefined}
      >
        <Astro.self content={part.children} linkContacts={false} />
      </a>
    ) : part.kind === 'qualification' ? (
      <span class="qualification">
        <Astro.self content={part.children} linkContacts={linkContacts} />
      </span>
    ) : (
      <part.kind>
        <Astro.self content={part.children} linkContacts={linkContacts} />
      </part.kind>
    ),
  )
}
<style>
  a {
    color: var(--color-primary-hover);
    font-weight: 500;
  }
  a:hover {
    color: var(--color-primary);
  }
  .contact {
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }
  .contact:hover {
    color: inherit;
  }
  .underlined {
    color: var(--color-primary);
    word-break: break-all;
    text-decoration: underline;
  }
  .native {
    color: #0000ee;
    text-decoration: underline;
  }
  .hero-phone {
    color: var(--color-accent);
    font-weight: 700;
  }
  .hero-phone:hover,
  .hero-phone:focus-visible {
    color: var(--color-white);
    text-decoration: underline;
  }
  .qualification {
    font-size: 22px;
  }
  @media screen and (max-width: 479px) {
    .qualification {
      line-height: 1;
    }
  }
</style>
