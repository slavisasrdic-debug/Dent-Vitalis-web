---
import type { InnerPage } from '../content/inner-pages';
import ResponsiveImage from './ResponsiveImage.astro';
import InlineContent from './InlineContent.astro';
interface Props {
  content: InnerPage['hero'];
}
const { content } = Astro.props;
---

<section class:list={['detail-hero', content.variant]}>
  {
    content.photo && (
      <div class="hero-photo">
        <>
          <ResponsiveImage
            image={content.photo.image}
            alt={content.photo.alt}
            eager
            fetchPriority="high"
            sizes="100vw"
          />
          <div class="shade" />
        </>
      </div>
    )
  }
  <div class="hero-container">
    <div class="hero-copy">
      {
        content.eyebrow && (
          <p class="eyebrow" data-reveal="slide" data-offset="0">
            {content.eyebrow}
          </p>
        )
      }<div>
        <h1>{content.title}</h1><p class="description">
          <InlineContent content={content.description} />
        </p>
      </div>
    </div>
  </div>
</section>
<style>
  .detail-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    width: 100%;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 50%;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-primary), #fff0 65%, #fff0);
  }
  .hero-container {
    width: 90%;
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    position: relative;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 45%;
    padding: 100px 100px 100px 0;
    color: white;
    text-align: left;
  }
  h1 {
    font-size: 46px;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 20px;
  }
  .description {
    margin: 20px 0 0;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.4;
  }
  /* Rich-text links need their own foreground on the blue hero surface. */
  .description :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .description :global(a:hover),
  .description :global(a:focus-visible) {
    color: var(--color-white);
  }
  .description :global(a:focus-visible) {
    outline-color: var(--color-white);
  }
  .eyebrow {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    margin: 10px 0 20px;
  }
  @media screen and (min-width: 992px) {
    .eyebrow {
      margin-bottom: 30px;
    }
  }
  .directory {
    min-height: 0;
    background: #087a93;
  }
  .directory .hero-copy {
    padding-block: 56px;
  }
  @media screen and (max-width: 991px) {
    .detail-hero {
      min-height: 0;
      flex-direction: column;
    }
    .hero-container {
      order: -1;
      width: 100%;
      background: linear-gradient(180deg, var(--color-primary), #117996);
    }
    .hero-copy,
    .directory .hero-copy {
      align-items: stretch;
      width: 100%;
      padding: 40px 5%;
    }
    .hero-photo {
      position: relative;
      width: 100%;
    }
    .hero-photo :global(img) {
      height: auto;
      aspect-ratio: 16/9;
      object-position: 100% 50%;
    }
    .shade {
      display: none;
    }
    h1 {
      font-size: 42px;
    }
    .description,
    .eyebrow {
      font-size: 20px;
    }
  }
  @media screen and (max-width: 767px) {
    h1 {
      font-size: 36px;
    }
    .hero-photo :global(img) {
      aspect-ratio: 1;
    }
  }
  @media screen and (max-width: 479px) {
    h1 {
      font-size: 32px;
    }
    .description,
    .eyebrow {
      font-size: 18px;
    }
    .hero-photo :global(img) {
      object-position: 90% 50%;
    }
    .specialists .hero-photo :global(img) {
      object-position: 95% 50%;
    }
  }
</style>
