---
// Elfsight WhatsApp is the only chat UI. Keep the scoped safeguard against
// a future accidental reactivation of the retired GTM Zendesk tags.
// Do not hide Elfsight, GTM/CookieYes or unrelated embeds. Hiding legacy UI
// does not stop its SDK/cookies; the obsolete GTM tags must stay paused.
---

<style is:inline data-legacy-chat-guard>
  iframe#launcher,
  iframe#webWidget {
    display: none !important;
    pointer-events: none !important;
  }
</style>
<script is:inline data-legacy-chat-guard>
  (() => {
    // The API can arrive asynchronously, including after a consent change.
    // CSS prevents the launcher's first-paint flash and pointer interception.
    const hideLegacyChat = () => {
      if (!document.querySelector('iframe#launcher, iframe#webWidget')) return;
      if (typeof window.zE !== 'function') return;
      window.zE('webWidget', 'hide');
      observer.disconnect();
    };
    const observer = new MutationObserver(hideLegacyChat);
    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
    hideLegacyChat();
  })();
</script>
