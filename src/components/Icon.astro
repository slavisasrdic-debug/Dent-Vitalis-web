---
interface Props {
  name: 'check' | 'calendar' | 'double-arrow' | 'arrow';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox={name === 'calendar' ? '0 0 32 32' : '0 0 24 24'}
  fill="none"
  aria-hidden="true"
>
  {
    name === 'check' && (
      <g
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <>
          <path d="m7 12.5 3 3 7-7" />
          <circle cx="12" cy="12" r="10" />
        </>
      </g>
    )
  }
  {
    name === 'double-arrow' && (
      <path
        d="m13 6 6 6-6 6M5 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'arrow' && (
      <path
        d="M5 12h14m-6-6 6 6-6 6"
        stroke="currentColor"
        stroke-width="1.5"
      />
    )
  }
  {
    name === 'calendar' && (
      <g fill="currentColor">
        <>
          <path d="M26 21h-3v-3h-2v3h-3v2h3v3h2v-3h3z" />
          <path d="M22 30c-4.4 0-8-3.6-8-8s3.6-8 8-8 8 3.6 8 8-3.6 8-8 8zm0-14c-3.3 0-6 2.7-6 6s2.7 6 6 6 6-2.7 6-6-2.7-6-6-6z" />
          <path d="M28 6c0-1.1-.9-2-2-2h-4V2h-2v2h-8V2h-2v2H6c-1.1 0-2 .9-2 2v20c0 1.1.9 2 2 2h6v-2H6V6h4v2h2V6h8v2h2V6h4v6h2V6z" />
        </>
      </g>
    )
  }
</svg>
<style>
  svg {
    display: block;
    flex: none;
  }
</style>
