---
import original from '../../public/assets/images/Dentvitalis-logo-color_21200px.svg?raw';

interface Props {
  label: string;
  variant?: 'header' | 'footer' | 'mark';
}
const { label, variant = 'header' } = Astro.props;
const viewBox = original.match(/\bviewBox="([^"]+)"/)?.[1];
// Inline the accepted artwork at build time, without editing its source bytes.
// The two unused Illustrator layer IDs must not repeat between logo instances.
const artwork = original
  .replace(/^[\s\S]*?<svg\b[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/\s+id="Layer_[^"]*"/g, '');
if (!viewBox || /\bid=|\bhref=|url\(|<script\b/i.test(artwork)) {
  throw new Error(
    'Logo artwork changed: review SVG references before inlining.',
  );
}
// Reuse the original green V and triangle, not an enlarged 16px favicon.
// Exact anchors deliberately fail if the accepted source artwork changes.
const mark = [...artwork.matchAll(/<(?:path|polygon)\b[^>]*\/>/g)]
  .map(([element]) => element)
  .filter(
    (element) =>
      element.startsWith('<path d="M70.63,22.23l-7.2-17.16') ||
      element.startsWith('<polygon points="68.3 0 72.4 11.87 76.48 0'),
  );
if (variant === 'mark' && mark.length !== 2) {
  throw new Error('Brand mark changed: review the original V and triangle.');
}
---

{
  variant === 'mark' ? (
    <svg
      data-brand-mark
      class="mark"
      role="img"
      aria-label={label}
      focusable="false"
      viewBox="61 -2 23 27"
      width="64"
      height="64"
    >
      <Fragment set:html={mark.join('')} />
    </svg>
  ) : variant === 'header' ? (
    <svg
      data-brand-logo
      class="header"
      role="img"
      aria-label={label}
      focusable="false"
      viewBox={viewBox}
      width="150"
      height="30"
    >
      <Fragment set:html={artwork} />
    </svg>
  ) : (
    // Preserve the original image rasterization at the footer's fractional height.
    // A data URL embeds the exact source bytes without an external image request.
    <img
      data-brand-logo
      class="footer"
      src={`data:image/svg+xml,${encodeURIComponent(original)}`}
      alt={label}
      width="140"
    />
  )
}

<style>
  svg,
  img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .header {
    height: 30px;
  }
  .footer {
    display: inline-block;
    vertical-align: middle;
  }
  .mark {
    height: 100%;
  }
</style>
