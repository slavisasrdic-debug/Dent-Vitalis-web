---
import { clinic } from '../content/site';
import { clinic as germanClinic } from '../content/de/site';
interface Props {
  src: string;
  lang?: string;
}
const { src } = Astro.props;
const address =
  Astro.props.lang === 'de' ? germanClinic.address : clinic.address;
---

<div class="map-panel">
  <iframe
    src={src}
    title={`DentVitalis — ${address}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe><a
    href={clinic.maps}
    target="_blank"
    rel="noopener noreferrer">{address}</a
  >
</div>
<style>
  .map-panel {
    width: 100%;
  }
  iframe {
    display: block;
    width: 100%;
    height: 450px;
    border: 0;
  }
  a {
    display: inline-block;
    color: var(--color-primary-hover);
    padding-block: 12px;
    text-decoration: underline;
    font-size: 16px;
  }
</style>
