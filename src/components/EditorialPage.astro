---
import type { InnerPage } from '../content/inner-pages';
import PageSidebar from './PageSidebar.astro';
import ContentBlocks from './ContentBlocks.astro';
import TeaserCard from './TeaserCard.astro';
import { ui } from '../content/ui';
import { privacyPresentation } from '../content/privacy-presentation';
interface Props {
  page: InnerPage;
}
const { page } = Astro.props;
const isPrivacy =
  (page.referenceRoute ?? page.route) === '/informativa-sulla-privacy';
const variant =
  (page.referenceRoute ?? page.route) === '/testimonianze'
    ? 'testimonials'
    : page.typography === 'reference-default'
      ? 'legal'
      : 'standard';
// Only the leading testimonial poster can enter the first tall desktop screen.
// This does not preload a YouTube player or promote subsequent video posters.
const eagerVideoId =
  variant === 'testimonials'
    ? page.blocks.find((block) => block.type === 'youtube')?.videoId
    : undefined;
// The shorter Croatian introduction exposes the first portrait on tall screens.
// Select it from existing content; later doctor portraits retain lazy loading.
const eagerImage =
  (page.referenceRoute ?? page.route) === '/su-di-noi/i-nostri-specialisti'
    ? page.blocks.find((block) => block.type === 'image')?.image
    : undefined;
---

<div
  class:list={['editorial-container', { 'trailing-space': page.trailingSpace }]}
>
  <div class="editorial-grid">
    {
      page.sidebar && (
        <PageSidebar
          id="sadrzaji"
          content={page.sidebar}
          current={page.route}
          variant={variant}
        />
      )
    }<article
      class:list={[
        'editorial-copy',
        { 'privacy-copy': isPrivacy, 'legal-copy': variant === 'legal' },
      ]}
    >
      <ContentBlocks
        blocks={isPrivacy
          ? privacyPresentation(page.blocks, page.lang ?? 'it')
          : page.blocks}
        lang={page.lang}
        eagerVideoId={eagerVideoId}
        eagerImage={eagerImage}
      />
    </article>
  </div>
</div>
{
  page.related.length > 0 && (
    <section class="related-services">
      <div class="related-container">
        <>
          <h2>{ui(page.lang).related}</h2>
          <div class="related-grid">
            {page.related.map((card) => (
              <TeaserCard card={card} variant="service" context="related" />
            ))}
          </div>
        </>
      </div>
    </section>
  )
}
<style>
  .editorial-container,
  .related-container {
    width: 90%;
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: start;
    padding-top: 40px;
  }
  /* The reference includes an empty trailing section on standard details.
     Model its measured spacing without copying its empty wrapper tree. */
  .trailing-space {
    --editorial-tail-space: 200px;
  }
  .editorial-container {
    padding-bottom: var(--editorial-tail-space, 0px);
  }
  .editorial-copy {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding-right: 80px;
  }
  /* Presentation only: preserve every legal block, word and link verbatim. */
  .privacy-copy,
  .legal-copy {
    font-family: var(--font-body);
    overflow-wrap: anywhere;
  }
  .privacy-copy :global(h2:first-child) {
    margin-top: 0;
  }
  .privacy-copy :global(h4.content-heading) {
    font-size: 20px;
    margin-block: 24px 12px;
  }
  .privacy-copy :global(#privacy-rights) {
    list-style-type: lower-alpha;
  }
  .related-services {
    width: 100%;
    padding-block: 80px 60px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }
  /* Keep the shared page margins: its 1400px maximum is too narrow for four
     readable cards. Two balanced rows preserve both alignment and typography. */
  .related-container > h2 {
    font-size: 34px;
    line-height: 1.2;
    margin-bottom: 40px;
    font-weight: 600;
  }
  @media screen and (min-width: 1280px) {
    .editorial-grid {
      padding-bottom: 60px;
    }
  }
  @media screen and (max-width: 991px) {
    .trailing-space {
      --editorial-tail-space: 140px;
    }
    .editorial-container {
      padding-bottom: calc(var(--editorial-tail-space, 0px) + 40px);
    }
    .editorial-grid {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }
    .editorial-copy {
      width: 100%;
      padding: 0;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  @media screen and (max-width: 767px) {
    .trailing-space {
      --editorial-tail-space: 120px;
    }
    .editorial-container,
    .related-container {
      width: 86%;
    }
  }
  @media screen and (max-width: 479px) {
    .related-container > h2 {
      font-size: 30px;
    }
    .editorial-container {
      padding-bottom: calc(var(--editorial-tail-space, 0px) + 30px);
    }
    .editorial-grid {
      padding-top: 20px;
    }
  }
</style>
