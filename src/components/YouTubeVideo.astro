---
import { ui } from '../content/ui';
import {
  isReplacedTestimonialVideo,
  testimonialEmbedUrl,
} from '../content/testimonial-videos';
interface Props {
  videoId: string;
  title: string;
  lang?: string;
  eager?: boolean;
}
const { videoId, title, lang = 'it', eager = false } = Astro.props;
const replaced = isReplacedTestimonialVideo(videoId);
if (!/^[\w-]{11}$/.test(videoId))
  throw new Error(`Invalid reference video ID: ${videoId}`);
---

<figure
  class="testimonial-video"
  data-youtube={videoId}
  data-title={title}
  data-embed-src={replaced ? testimonialEmbedUrl(videoId, lang) : undefined}
>
  <div class="player">
    <a
      href={`https://www.youtube.com/watch?v=${videoId}`}
      aria-label={`${ui(lang).watchVideo}: ${title}`}
      ><img
        src={`/assets/images/youtube-${videoId}.webp`}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        width={replaced ? 1280 : 480}
        height={replaced ? 720 : 360}
      /><span class="play" aria-hidden="true"
        ><svg viewBox="0 0 68 48" width="68" height="48"
          ><rect width="68" height="48" rx="12" fill="#f00"></rect><path
            d="m27 14 18 10-18 10z"
            fill="#fff"></path></svg
        ></span
      ></a
    >
  </div><figcaption>{title}</figcaption>
</figure>
<style>
  figure {
    margin: 0 0 40px;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
  }
  .player {
    position: relative;
    aspect-ratio: 16/9;
    background: #000;
  }
  a {
    display: block;
    height: 100%;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  figcaption {
    margin-top: 20px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }
  .player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const link = root.querySelector('a')!;
    link.addEventListener('click', (event) => {
      event.preventDefault();
      if (root.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src =
        root.dataset.embedSrc ??
        `https://www.youtube-nocookie.com/embed/${root.dataset.youtube}?autoplay=1`;
      frame.title = root.dataset.title!;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      if (root.dataset.embedSrc)
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(frame);
      frame.focus();
    });
  });
</script>
