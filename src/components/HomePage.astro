---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import { clinic, contactCopy as itContactCopy } from '../content/site';
import { contactCopy as hrContactCopy } from '../content/hr/site';
import * as it from '../content/home';
import * as hr from '../content/hr/home';
import * as sl from '../content/sl/home';
import { contactCopy as slContactCopy } from '../content/sl/site';
import * as en from '../content/en/home';
import { contactCopy as enContactCopy } from '../content/en/site';
import * as de from '../content/de/home';
import { contactCopy as deContactCopy } from '../content/de/site';
import { plain } from '../content/seo';

import { homeQuestions as itQuestions } from '../content/faq';
import SectionHeading from '../components/SectionHeading.astro';
import TeaserSequence from '../components/home/TeaserSequence.astro';
import Welcome from '../components/home/Welcome.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Information from '../components/home/Information.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import ContactSection from '../components/ContactSection.astro';
import VideoPosterPreload from '../components/VideoPosterPreload.astro';
import { heroVideos } from '../content/background-videos';
interface Props {
  lang?: 'it' | 'hr' | 'de' | 'en' | 'sl';
}
const { lang = 'it' } = Astro.props;
const { home, services, aboutCards, welcome, testimonials, informationCards } =
  lang === 'hr'
    ? hr
    : lang === 'de'
      ? de
      : lang === 'en'
        ? en
        : lang === 'sl'
          ? sl
          : it;
const questions =
  lang === 'hr'
    ? hr.homeQuestions
    : lang === 'de'
      ? de.homeQuestions
      : lang === 'en'
        ? en.homeQuestions
        : lang === 'sl'
          ? sl.homeQuestions
          : itQuestions;
const contactCopy =
  lang === 'hr'
    ? hrContactCopy
    : lang === 'de'
      ? deContactCopy
      : lang === 'en'
        ? enContactCopy
        : lang === 'sl'
          ? slContactCopy
          : itContactCopy;
const seoQuestions =
  lang !== 'it'
    ? (lang === 'de'
        ? de
        : lang === 'en'
          ? en
          : lang === 'sl'
            ? sl
            : hr
      ).homeQuestions.map((q) => ({
        question: q.question,
        answer: plain(q.richAnswer),
      }))
    : itQuestions.map((q) => ({
        question: q.question,
        answer: q.answer.map((a) => (a.break ? '\n' : (a.text ?? ''))).join(''),
      }));
---

<SiteLayout
  {...home.metadata}
  lang={lang}
  canonical={`https://www.dentvitalis.com${lang === 'it' ? '/' : `/${lang === 'sl' ? 'si' : lang}/`}`}
  seo={{ questions: seoQuestions }}
>
  <Fragment slot="head">
    <VideoPosterPreload {...heroVideos.desktop} />
    <VideoPosterPreload {...heroVideos.mobile} />
  </Fragment>
  <Hero
    price={clinic.premiumPrice}
    benefits={home.benefits}
    maps={clinic.maps}
    content={home.hero}
  />
  <section class="intro-section">
    <SectionHeading {...home.intro} variant="intro" />
  </section>
  <TeaserSequence
    cards={services}
    variant="service"
    label={lang === 'hr'
      ? 'Usluge'
      : lang === 'de'
        ? 'Dienstleistungen'
        : lang === 'en'
          ? 'Services'
          : lang === 'sl'
            ? 'Storitve'
            : 'Prestazioni'}
  />
  <Welcome content={welcome} />
  <section>
    <SectionHeading {...home.about} /><TeaserSequence
      cards={aboutCards}
      variant="about"
      label={home.about.eyebrow}
    />
  </section>
  <Testimonials
    heading={home.testimonials}
    slides={testimonials}
    actions={home.testimonialActions}
    photo={home.testimonialPhoto}
    lang={lang}
  />
  <Information
    heading={home.information}
    cards={informationCards}
    action={home.informationAction}
  />
  <HomeFAQ heading={home.faq} questions={questions} action={home.faqAction} />
  <ContactSection content={contactCopy} lang={lang} />
</SiteLayout>
