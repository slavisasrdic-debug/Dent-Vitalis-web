---
import Button from './Button.astro';
import type { chatCopy } from '../content/site';
import { ui } from '../content/ui';
interface Props {
  consultation: string;
  whatsapp: string | null;
  content: typeof chatCopy;
  lang?: string;
}
const { consultation, whatsapp, content, lang = 'it' } = Astro.props;
const copy = ui(lang);
---

<div class="chat-widget" data-chat-widget>
  <div class="chat-panel" hidden>
    <div class="chat-header">
      <span class="avatar"></span><div>
        <p>{content.team}</p><small>{content.responseTime}</small>
      </div><button type="button" data-chat-close aria-label={copy.closeChat}
        ><img
          src="/assets/images/close-live-chat.svg"
          alt=""
          width="16"
          height="16"
        /></button
      >
    </div><div class="chat-body">
      <div class="chat-bubble">
        <p>{content.team}</p><span
          >{content.greeting}<br />{content.message}</span
        >
      </div>
    </div><div class="chat-action">
      {
        whatsapp ? (
          <a href={`https://wa.me/${whatsapp}`}>
            <img src="/assets/images/small-whatsapp.svg" alt="" />
            {content.action}
          </a>
        ) : (
          <div>
            <>
              <button type="button" disabled>
                <img src="/assets/images/small-whatsapp.svg" alt="" />
                {content.action}
              </button>
              <small>{content.unavailable}</small>
            </>
          </div>
        )
      }
    </div>
  </div><button
    class="chat-toggle"
    type="button"
    aria-label={copy.openChat}
    aria-expanded="false"
    ><img
      src="/assets/images/whatsapp.svg"
      alt=""
      width="31"
      height="31"
    /></button
  >
  <span class="badge" aria-hidden="true">1</span>
</div>
<div class="mobile-contact">
  <Button href="#contatti" label={consultation} variant="consultation" />
</div>
<style>
  .chat-widget {
    position: fixed;
    z-index: 30;
    right: 30px;
    bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .chat-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: #00b94a;
    border: 1px solid #ffffff4d;
    border-radius: 50%;
    transition:
      background 0.3s,
      transform 0.3s cubic-bezier(0.45, 0.182, 0.111, 0.989);
  }
  .chat-toggle:hover {
    background: #383838;
    transform: scale(1.05);
  }
  .badge {
    position: absolute;
    bottom: 40px;
    right: 40px;
    pointer-events: none;
    width: 20px;
    height: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: #bf1212;
    color: white;
    font-size: 14px;
    line-height: 14px;
  }
  .chat-panel {
    width: 300px;
    height: 315px;
    background: white;
    border: 1px solid #00000029;
    border-radius: 20px;
    margin-bottom: 16px;
    overflow: hidden;
    animation: chat-enter 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .chat-header {
    height: 25%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .chat-header p {
    font-size: 12px;
    font-weight: 500;
  }
  .chat-header small {
    font-size: 10px;
    display: block;
    line-height: 20px;
  }
  .chat-header > div {
    width: 193px;
  }
  .chat-header button {
    padding: 0;
    background: none;
    border: 0;
    width: 10%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .chat-header button img {
    width: 17px;
    height: 17px;
  }
  .chat-body {
    height: 50%;
    background: #e6ddd4;
    padding: 16px 20px;
  }
  .chat-bubble {
    width: 80%;
    padding: 15px;
    border-radius: 8px;
    background: white;
    font-size: 12px;
  }
  .chat-bubble p {
    margin-bottom: 10px;
    color: #b0b0b0;
    font-weight: 500;
  }
  .chat-bubble > span {
    display: block;
    margin-bottom: 5px;
  }
  .chat-action {
    height: 25%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .chat-action button,
  .chat-action a {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 42px;
    border: 0;
    border-radius: 200px;
    padding: 0 20px;
    background: black;
    color: white;
    font-size: 14px;
  }
  .chat-action > div {
    width: 80%;
    position: relative;
  }
  .chat-action :is(a, button) {
    width: 100%;
    gap: 10px;
    padding: 0;
  }
  .chat-action img {
    width: 16px;
    height: 16px;
  }
  .chat-action small {
    font-size: 10px;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    line-height: 12px;
  }
  .mobile-contact {
    display: none;
  }
  @keyframes chat-enter {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Phase begins at the dim point, so the first paint fades IN, never out.
     At 7s: bright peaks at .5s / 1.5s, then a full 5s hold until 6.5s.
     The final half-second leads smoothly into the next cycle, without a jump. */
  @keyframes sticky-cta-attention {
    0%,
    14.285714%,
    100% {
      opacity: var(--sticky-cta-min-opacity);
    }
    7.142857%,
    21.428571%,
    92.857143% {
      opacity: 1;
    }
  }
  @media screen and (max-width: 991px) {
    .mobile-contact {
      display: flex;
      position: fixed;
      bottom: 0;
      width: 100%;
      z-index: 998;
      justify-content: center;
      padding: 6px 20px;
      background: white;
    }
    .mobile-contact :global(.button) {
      text-transform: uppercase;
      font-size: 17px;
      height: 48px;
    }
    .mobile-contact :global(.button > :is(svg, .label)) {
      animation: sticky-cta-attention var(--sticky-cta-cycle-duration)
        var(--sticky-cta-easing) infinite both;
    }
    .mobile-contact :global(.button:focus-within > :is(svg, .label)),
    .mobile-contact :global(.button:active > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
    .chat-widget {
      bottom: 100px;
      right: 20px;
      z-index: 105;
    }
    .chat-toggle {
      border-width: 2px;
      border-color: white;
    }
  }
  @media screen and (max-width: 991px) and (hover: hover) and (pointer: fine) {
    .mobile-contact :global(.button:hover > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
  }
  @media screen and (max-width: 767px) {
    .chat-widget {
      bottom: 80px;
      right: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-contact :global(.button > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
    .chat-panel {
      animation: none;
    }
    .chat-toggle {
      transition: none;
    }
  }
  @media screen and (max-width: 479px) {
    .chat-widget {
      right: 10px;
    }
    .chat-toggle {
      bottom: 10px;
    }
    .chat-panel {
      width: calc(100vw - 20px);
      height: 40vh;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-chat-widget]')
    .forEach((widget) => {
      if (widget.dataset.ready) return;
      widget.dataset.ready = 'true';
      const button = widget.querySelector<HTMLButtonElement>('.chat-toggle')!;
      const panel = widget.querySelector<HTMLElement>('.chat-panel')!;
      const setOpen = (open: boolean) => {
        panel.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
      widget
        .querySelector('[data-chat-close]')!
        .addEventListener('click', () => {
          setOpen(false);
          button.focus();
        });
      widget.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(false);
          button.focus();
        }
      });
    });
</script>
