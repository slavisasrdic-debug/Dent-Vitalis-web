---
import Button from './Button.astro';
import ElfsightWhatsApp from './ElfsightWhatsApp.astro';

interface Props {
  consultation: string;
  whatsapp: string | null;
  lang?: string;
}
const { consultation, whatsapp, lang = 'it' } = Astro.props;
---

<ElfsightWhatsApp lang={lang} whatsapp={whatsapp} />
<div class="mobile-contact">
  <Button href="#contatti" label={consultation} variant="consultation" />
</div>
<style>
  .mobile-contact {
    display: none;
  }
  /* Existing mobile consultation CTA is independent of the WhatsApp SDK. */
  @keyframes sticky-cta-attention {
    0%,
    14.285714%,
    100% {
      opacity: var(--sticky-cta-min-opacity);
    }
    7.142857%,
    21.428571%,
    92.857143% {
      opacity: 1;
    }
  }
  @media screen and (max-width: 991px) {
    .mobile-contact {
      display: flex;
      position: fixed;
      bottom: 0;
      width: 100%;
      z-index: 998;
      justify-content: center;
      padding: 6px 20px;
      background: white;
    }
    .mobile-contact :global(.button) {
      text-transform: uppercase;
      font-size: 17px;
      height: 48px;
    }
    .mobile-contact :global(.button > :is(svg, .label)) {
      animation: sticky-cta-attention var(--sticky-cta-cycle-duration)
        var(--sticky-cta-easing) infinite both;
    }
    .mobile-contact :global(.button:focus-within > :is(svg, .label)),
    .mobile-contact :global(.button:active > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
  }
  @media screen and (max-width: 991px) and (hover: hover) and (pointer: fine) {
    .mobile-contact :global(.button:hover > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-contact :global(.button > :is(svg, .label)) {
      animation: none;
      opacity: 1;
    }
  }
</style>
