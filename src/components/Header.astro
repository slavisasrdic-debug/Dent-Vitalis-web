---
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import NavDropdown from './NavDropdown.astro';
import { ui } from '../content/ui';
import type { NavigationGroup, LinkData, LanguageLink } from '../content/site';
interface Props {
  groups: NavigationGroup[];
  links: LinkData[];
  languages: LanguageLink[];
  lang: string;
  tagline: string;
  consultation: string;
  request: LinkData;
}
const { groups, links, languages, lang, tagline, consultation, request } =
  Astro.props;
const id = `navigation-${crypto.randomUUID()}`;
const copy = ui(lang);
---

<header class="site-header" data-header>
  <div class="header-container">
    <div class="header-row">
      <a href={lang === 'hr' ? '/hr/' : '/'} class="brand"
        ><img
          src="/assets/images/Dentvitalis-logo-color_21200px.svg"
          width="150"
          height="30"
          alt={copy.logo}
          fetchpriority="high"
          loading="eager"
        /><span>{tagline}</span></a
      >
      <nav id={id} aria-label={copy.nav} class="site-nav">
        <div class="nav-items">
          {groups.map((group) => <NavDropdown group={group} />)}
          {
            links.map((link) => (
              <a
                class="nav-link"
                href={link.href}
                aria-current={
                  Astro.url.pathname.replace(/\/$/, '') === link.href
                    ? 'page'
                    : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
          <div class="desktop-language">
            <LanguageSwitcher languages={languages} current={lang} />
          </div>
          <div class="menu-request"><Button {...request} variant="menu" /></div>
        </div>
      </nav>
      <div class="header-actions">
        <div class="header-consultation">
          <Button
            href="#contatti"
            label={consultation}
            variant="consultation"
          />
        </div><LanguageSwitcher
          languages={languages}
          current={lang}
          variant="mobile"
        /><button
          type="button"
          class="menu-toggle"
          aria-label={copy.openMenu}
          data-open-label={copy.openMenu}
          data-close-label={copy.closeMenu}
          aria-expanded="false"
          aria-controls={id}
          ><img
            class="menu-icon"
            src="/assets/images/menu-btn.svg"
            alt=""
            width="26"
            height="22"
          /><img
            class="close-icon"
            src="/assets/images/close-btn.svg"
            alt=""
            width="17"
            height="16"
          /></button
        >
      </div>
    </div>
  </div>
</header>
<noscript
  ><style>
    @media screen and (max-width: 991px) {
      .site-header {
        position: relative !important;
        height: auto !important;
      }
      .header-row {
        flex-wrap: wrap;
        padding-top: 10px;
      }
      .site-nav {
        display: block !important;
        visibility: visible !important;
        transform: none !important;
        position: static !important;
        order: 3;
        height: auto !important;
      }
      .menu-toggle {
        display: none !important;
      }
    }
  </style></noscript
>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    width: 100%;
    height: var(--header-height);
    padding-inline: 20px;
    border-bottom: 1px solid var(--color-border-translucent);
    background: white;
    backdrop-filter: blur(10px);
  }
  .header-container {
    max-width: 1200px;
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
  }
  .header-row {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    column-gap: 6px;
    row-gap: 10px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    width: 150px;
    min-width: 137px;
    color: #00647e;
  }
  .brand img {
    width: 100%;
    height: 30px;
  }
  .brand span {
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .site-nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    margin-left: auto;
  }
  .nav-items {
    display: flex;
    align-items: center;
    gap: 6px 4px;
    padding-top: 2px;
  }
  .nav-link {
    padding: 10px 3px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1;
    font-weight: 500;
  }
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--color-accent);
  }
  .header-actions {
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    margin-left: -4px;
  }
  .menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .menu-request {
    display: none;
  }
  .close-icon {
    display: none;
  }
  @media screen and (min-width: 1280px) {
    .header-container {
      max-width: 1400px;
    }
    .nav-items {
      gap: 8px;
    }
    .site-nav {
      justify-content: center;
    }
    .nav-link {
      font-size: 16px;
    }
  }
  @media screen and (min-width: 1440px) {
    .site-header {
      padding-inline: 5%;
    }
    .header-row {
      column-gap: 10px;
    }
    .nav-items {
      column-gap: 6px;
    }
    .site-nav {
      flex: 0 auto;
    }
    .nav-link {
      padding-inline: 0.8vw;
      font-size: 15px;
    }
  }
  @media screen and (min-width: 1920px) {
    .header-row {
      min-width: 100%;
    }
    .nav-items {
      margin-left: auto;
    }
  }
  @media screen and (max-width: 991px) {
    .menu-request {
      display: block;
      margin-top: 20px;
    }
    .site-header {
      padding: 0;
    }
    .header-container {
      padding-inline: 5%;
    }
    .brand {
      width: 140px;
    }
    .brand span {
      letter-spacing: 0.375px;
    }
    .site-nav {
      display: none;
      position: fixed;
      top: 70px;
      left: 0;
      width: 100%;
      height: calc(100dvh - 70px);
      background: var(--color-surface);
      overflow-y: auto;
      margin: 0;
    }
    .site-nav[data-open] {
      display: block;
      animation: mobile-menu-enter 400ms ease;
    }
    .nav-items {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 20px 5% 40px;
    }
    .nav-link {
      width: 100%;
      padding: 20px;
      border-bottom: 1px solid var(--color-border);
      font-size: 16px;
      color: #282828;
    }
    .desktop-language,
    .header-consultation {
      display: none;
    }
    .header-actions {
      margin: 0;
      gap: 10px;
      align-items: center;
    }
    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 22px;
    }
    .menu-toggle[aria-expanded='true'] .menu-icon {
      display: none;
    }
    .menu-toggle[aria-expanded='true'] .close-icon {
      display: block;
    }
  }
  @media screen and (max-width: 479px) {
    .header-container {
      padding-inline: 7%;
    }
    .nav-items {
      padding-inline: 7%;
    }
    .nav-link {
      width: 99%;
      padding-block: 16px;
    }
  }
  @keyframes mobile-menu-enter {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav[data-open] {
      animation: none;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((header) => {
    if (header.dataset.ready) return;
    header.dataset.ready = 'true';
    const button = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
    const nav = header.querySelector<HTMLElement>('nav')!;
    let previousOverflow = '';
    let closing: Animation | null = null;
    const setOpen = (open: boolean) => {
      const wasOpen = button.getAttribute('aria-expanded') === 'true';
      closing?.cancel();
      closing = null;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute(
        'aria-label',
        (open ? button.dataset.closeLabel : button.dataset.openLabel)!,
      );
      if (open) {
        if (!wasOpen) previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        nav.setAttribute('data-open', '');
      } else {
        if (wasOpen) document.body.style.overflow = previousOverflow;
        if (
          wasOpen &&
          matchMedia('(max-width:991px)').matches &&
          !matchMedia('(prefers-reduced-motion:reduce)').matches
        ) {
          closing = nav.animate(
            [{ transform: 'none' }, { transform: 'translateX(-100%)' }],
            { duration: 400, easing: 'ease' },
          );
          closing.onfinish = () => {
            nav.removeAttribute('data-open');
            closing = null;
          };
        } else nav.removeAttribute('data-open');
      }
    };
    button.addEventListener('click', () =>
      setOpen(button.getAttribute('aria-expanded') !== 'true'),
    );
    header.addEventListener('keydown', (event) => {
      if (
        event.key === 'Tab' &&
        button.getAttribute('aria-expanded') === 'true'
      ) {
        const focusable = [
          ...header.querySelectorAll<HTMLElement>(
            'a[href],summary,button:not([disabled])',
          ),
        ].filter(
          (e) =>
            e.checkVisibility({ visibilityProperty: true }) &&
            e.getBoundingClientRect().height > 0,
        );
        const first = focusable[0],
          last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
      if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        button.focus();
      }
    });
    matchMedia('(min-width:992px)').addEventListener('change', () =>
      setOpen(false),
    );
  });
</script>
