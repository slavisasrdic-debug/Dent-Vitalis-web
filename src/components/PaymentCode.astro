---
import { paymentCopy, paymentImage } from '../content/payment-code';
interface Props {
  lang?: string;
}
const copy =
  paymentCopy[
    Astro.props.lang === 'hr'
      ? 'hr'
      : Astro.props.lang === 'de'
        ? 'de'
        : Astro.props.lang === 'en'
          ? 'en'
          : 'it'
  ];
---

<section class="payment-code">
  <h2>{copy.title}</h2>
  <p>{copy.instruction}</p>
  <img
    src={paymentImage}
    width="512"
    height="126"
    alt={copy.title}
    loading="lazy"
  />
</section>
<style>
  .payment-code {
    margin-block: 40px;
  }
  h2 {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  p {
    font-size: 18px;
    line-height: 1.5;
    margin-block: 20px;
  }
  img {
    display: block;
    width: 512px;
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 479px) {
    h2 {
      font-size: 26px;
    }
  }
</style>
