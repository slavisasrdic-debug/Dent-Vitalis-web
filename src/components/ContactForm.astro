---
import Icon from './Icon.astro';
import type { contactCopy } from '../content/site';
interface Props {
  content: typeof contactCopy;
  lang: string;
  placement?: string;
}
const { content, lang, placement = 'home_inline' } = Astro.props;
const id = `inquiry-${crypto.randomUUID()}`;
---

<form
  class="contact-form"
  data-contact-form
  data-placement={placement}
  data-unavailable={content.unavailable}
  data-file-too-large={content.fileTooLarge}
  data-invalid-file={content.invalidFile}
  data-file-limit={content.limit}
  method="dialog"
>
  <div class="fields">
    <label class="sr-only" for={`${id}-name`}>{content.name}</label><input
      id={`${id}-name`}
      name="name"
      type="text"
      autocomplete="given-name"
      placeholder={`*${content.name}:`}
      required
    />
    <label class="sr-only" for={`${id}-email`}>{content.email}</label><input
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      placeholder={`*${content.email}:`}
      required
    />
    <label class="sr-only" for={`${id}-phone`}>{content.phone}</label><input
      class="phone"
      id={`${id}-phone`}
      name="phone"
      type="tel"
      autocomplete="tel"
      placeholder={`${content.phone}:`}
    />
    <label class="sr-only" for={`${id}-message`}>{content.message}</label
    ><textarea
      id={`${id}-message`}
      name="message"
      placeholder={`${content.message}:`}></textarea>
  </div>
  <div class="upload">
    <div class="upload-row">
      <label class="upload-button" for={`${id}-file`}
        ><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path></svg
        ><span class="upload-label">{content.upload}</span><input
          class="file-input"
          id={`${id}-file`}
          type="file"
          name="file"
          accept=".pdf,.jpg,.jpeg,.png"
          aria-describedby={`${id}-file-name ${id}-file-error`}
        /></label
      ><span id={`${id}-file-name`} class="file-name" aria-live="polite"
        >{content.limit}</span
      >
    </div>
    <p id={`${id}-file-error`} class="file-error" aria-live="polite" hidden></p>
  </div>
  <label class="consent"
    ><input type="checkbox" name="form_agreement" value="1" required /><span
      >{content.privacyPrefix}<a href={content.privacyHref}>{content.privacy}</a
      ></span
    ></label
  >
  <input type="hidden" name="lang" value={lang} /><input
    type="hidden"
    name="source_page_url"
  /><input type="hidden" name="source_page_path" /><input
    type="hidden"
    name="source_page_title"
  /><input type="hidden" name="form_placement" value={placement} />
  <div class="submit-row">
    <button class="submit" type="button" data-submit disabled
      ><span>{content.submit}</span><span class="submit-arrow"
        ><Icon name="double-arrow" size={32} /></span
      ></button
    >
  </div>
  <p class="form-status" role="status" hidden></p>
  <noscript><p class="form-status">{content.unavailable}</p></noscript>
</form>
<style>
  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 50px 0;
  }
  .fields input,
  .fields textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 60px;
    height: 60px;
    padding: 14px 16px;
    border: 1px solid #c8d9de;
    border-radius: 6px;
    background: white;
    color: #173c46;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.2px;
  }
  .fields input::placeholder,
  .fields textarea::placeholder {
    color: #71858b;
    opacity: 1;
  }
  .phone,
  .fields textarea {
    grid-column: 1/-1;
  }
  .fields textarea {
    min-height: 112px;
    resize: vertical;
    letter-spacing: normal;
  }
  .upload {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .upload-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .upload-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 16px;
    flex: 0 0 auto;
    max-width: 100%;
    min-height: 56px;
    border: 1px solid #c8d9de;
    border-radius: 4px;
    background: white;
    color: #05617a;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
    cursor: pointer;
  }
  .upload-button svg {
    flex: none;
  }
  .upload-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .upload-button:hover {
    border-color: var(--color-primary-hover);
    color: var(--color-primary);
  }
  .file-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .file-name {
    min-width: 0;
    flex: 1;
    color: #ffffffdb;
    font-size: 12px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .file-error {
    margin: 0;
    padding: 10px 12px;
    border-left: 3px solid var(--color-primary-hover);
    border-radius: 4px;
    background: white;
    color: #173c46;
    font-size: 14px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding-left: 10px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.45;
  }
  .consent input {
    appearance: none;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    margin: 2px 10px 0 0;
    border: 1.5px solid white;
    border-radius: 2px;
    background: white;
  }
  .consent input:checked {
    background: var(--color-accent);
    box-shadow: inset 0 0 0 3px white;
  }
  .consent a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .submit-row {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .submit {
    display: grid;
    grid-template-columns: 3fr 1fr;
    align-items: center;
    height: 56px;
    padding: 0 0 0 30px;
    border: 0;
    border-radius: 10px;
    background: var(--color-accent);
    color: white;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }
  .submit > span:first-child {
    padding: 10px 30px 10px 0;
  }
  .submit-arrow {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    padding: 10px 20px;
    position: relative;
  }
  .submit-arrow::before {
    content: '';
    position: absolute;
    right: calc(100% + 6px);
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: #ffffff80;
  }
  .submit:hover {
    background: color-mix(in srgb, var(--color-accent) 92%, black);
  }
  .form-status {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 4px;
    background: white;
    color: #173c46;
    font-size: 14px;
    line-height: 1.45;
  }
  .upload-button:focus-within {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }
  [data-placement='home_popup'] .fields {
    margin: 0;
  }
  [data-placement='home_popup'] .fields textarea {
    min-height: 96px;
  }
  [data-placement='home_popup'] .upload-button {
    flex: none;
    min-height: 52px;
    gap: 10px;
  }
  [data-placement='home_popup'] .file-name {
    flex: none;
    color: #41585f;
  }
  [data-placement='home_popup'] .consent {
    color: #41585f;
    padding-left: 10px;
    margin-top: 18px;
    font-weight: 400;
  }
  [data-placement='home_popup'] .consent input {
    border-color: #05617a;
    margin-right: 0;
  }
  [data-placement='home_popup'] .consent a {
    color: #05617a;
    font-weight: 400;
  }
  [data-placement='home_popup'] .fields :is(input, textarea):focus {
    border-color: #05617a;
    outline: 3px solid #05617a;
    outline-offset: 2px;
  }
  [data-placement='home_popup'] .upload {
    margin-top: 14px;
  }
  [data-placement='home_popup'] .upload-row {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  [data-placement='home_popup'] .submit {
    width: min(100%, 340px);
    grid-template-columns: minmax(0, 1fr) 64px;
    padding: 0;
    background: var(--color-primary);
  }
  [data-placement='home_popup'] .submit > span:first-child {
    padding: 0 18px;
  }
  [data-placement='home_popup'] .submit-arrow {
    padding: 0;
    border-left: 1px solid #ffffff8c;
  }
  [data-placement='home_popup'] .submit-arrow::before {
    display: none;
  }
  [data-placement='home_popup'] .submit-arrow :global(svg) {
    width: 24px;
    height: 24px;
  }
  [data-placement='home_popup'] .submit-row {
    margin-top: 22px;
  }
  @media screen and (max-width: 767px) {
    .fields {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .fields input,
    .fields textarea {
      min-height: 52px;
      font-size: 16px;
    }
    .fields textarea {
      min-height: 104px;
    }
    .upload-row {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .upload-button {
      min-height: 52px;
      padding-inline: 12px 11px;
      gap: 7px;
      font-size: 16px;
    }
    .upload-button svg {
      width: 16px;
      height: 16px;
    }
    .file-name {
      flex: none;
      font-size: 12px;
      line-height: 1.4;
    }
    .submit-row {
      margin-top: 20px;
    }
    .submit-arrow::before {
      top: 7px;
      bottom: 7px;
    }
    [data-placement='home_popup'] .submit {
      width: 100%;
      grid-template-columns: minmax(0, 1fr) 58px;
      min-height: 52px;
      height: 52px;
    }
    [data-placement='home_popup'] .submit-row {
      margin-top: 20px;
    }
    [data-placement='home_popup'] .fields input,
    [data-placement='home_popup'] .fields textarea {
      font-size: 18px;
    }
    [data-placement='home_popup'] .fields textarea {
      min-height: 84px;
    }
    [data-placement='home_popup'] .upload-button {
      width: 100%;
      min-height: 48px;
    }
    [data-placement='home_popup'] .consent {
      font-size: 13px;
      line-height: 1.35;
    }
  }
  @media screen and (max-width: 479px) {
    .submit {
      width: 100%;
      min-height: 56px;
      height: auto;
      padding-left: 20px;
    }
  }
  @media screen and (max-width: 479px) {
    [data-placement='home_popup'] .submit {
      min-height: 52px;
      height: 52px;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLFormElement>('[data-contact-form]')
    .forEach((form) => {
      if (form.dataset.ready) return;
      form.dataset.ready = 'true';
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const fileInput = form.querySelector<HTMLInputElement>('[type=file]')!;
      const fileError = form.querySelector<HTMLElement>('.file-error')!;
      const status = form.querySelector<HTMLElement>('.form-status')!;
      const show = (message: string) => {
        status.textContent = message;
        status.hidden = false;
      };
      const updateSource = () => {
        const source = new URL(location.href);
        source.hash = '';
        const fields = {
          source_page_url: source.href,
          source_page_path: source.pathname,
          source_page_title: document.title,
          form_placement: form.dataset.placement || 'home_inline',
        };
        Object.entries(fields).forEach(([name, value]) => {
          form.querySelector<HTMLInputElement>(`[name=${name}]`)!.value = value;
        });
      };
      updateSource();
      submit.disabled = false;
      form.addEventListener('submit', (event) => event.preventDefault());
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        form.querySelector('.file-name')!.textContent =
          file?.name || form.dataset.fileLimit!;
        const message =
          file && file.size > 8 * 1024 * 1024
            ? form.dataset.fileTooLarge!
            : file && !/\.(pdf|jpe?g|png)$/i.test(file.name)
              ? form.dataset.invalidFile!
              : '';
        fileInput.setCustomValidity(message);
        fileInput.setAttribute('aria-invalid', String(Boolean(message)));
        fileError.textContent = message;
        fileError.hidden = !message;
      });
      submit.addEventListener('click', () => {
        updateSource();
        if (form.reportValidity()) show(form.dataset.unavailable!);
      });
    });
</script>
