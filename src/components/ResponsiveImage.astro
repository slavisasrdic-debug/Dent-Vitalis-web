---
import homeAssets from '../content/home-assets.json';
import innerAssets from '../content/inner-assets.json';
const assets = { ...homeAssets, ...innerAssets };
export type ImageKey = keyof typeof assets;
interface Props {
  image: string;
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  reveal?: boolean;
}
const {
  image,
  alt,
  sizes = '100vw',
  class: className,
  eager = false,
} = Astro.props;
const asset = assets[image as ImageKey];
if (!asset) throw new Error(`Unknown source image: ${image}`);
---

<img
  data-reveal={Astro.props.reveal ? 'grow' : undefined}
  data-delay={Astro.props.reveal ? 400 : undefined}
  data-offset={Astro.props.reveal ? 0 : undefined}
  class={className}
  src={asset.src}
  alt={alt}
  width={'width' in asset ? asset.width : undefined}
  height={'height' in asset ? asset.height : undefined}
  srcset={'variants' in asset
    ? asset.variants
        .map((variant) => `${variant.src} ${variant.width}w`)
        .join(', ')
    : undefined}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
