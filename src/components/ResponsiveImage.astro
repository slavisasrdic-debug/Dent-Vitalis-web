---
import { imageAttributes } from '../content/images';
export type { ImageKey } from '../content/images';
import transparent from '../../public/assets/images/transparent.svg?raw';
interface Props {
  image: string;
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  eagerMedia?: string | undefined;
  fetchPriority?: 'high' | 'low' | 'auto';
  reveal?: boolean;
}
const {
  image,
  alt,
  sizes = '100vw',
  class: className,
  eager = false,
  eagerMedia,
} = Astro.props;
const asset = imageAttributes(image);
---

{
  eager && eagerMedia ? (
    <picture class="eager-picture">
      <source
        media={`not all and ${eagerMedia}`}
        srcset={`data:image/svg+xml,${encodeURIComponent(transparent)}`}
      />
      <Astro.self {...Astro.props} eagerMedia={undefined} />
    </picture>
  ) : (
    <img
      data-reveal={Astro.props.reveal ? 'grow' : undefined}
      data-delay={Astro.props.reveal ? 400 : undefined}
      data-offset={Astro.props.reveal ? 0 : undefined}
      class={className}
      {...asset}
      alt={alt}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={Astro.props.fetchPriority}
      decoding="async"
    />
  )
}
<style>
  .eager-picture {
    display: contents;
  }
</style>
