---
import type { ContentBlock } from '../content/inner-pages';
import InlineContent from './InlineContent.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import GalleryComparison from './GalleryComparison.astro';
import YouTubeVideo from './YouTubeVideo.astro';
import FAQ from './FAQ.astro';
import Icon from './Icon.astro';
import MapPanel from './MapPanel.astro';
import ContactRow from './ContactRow.astro';
import ReviewSource from './ReviewSource.astro';
interface Props {
  blocks: ContentBlock[];
  lang?: string;
  eagerVideoId?: string | undefined;
  eagerImage?: string | undefined;
}
const { blocks, lang = 'it', eagerVideoId, eagerImage } = Astro.props;
---

{
  blocks.map((block) => {
    if (block.type === 'list') {
      const List = block.ordered ? 'ol' : 'ul';
      return (
        <List class="content-list">
          {block.items.map((items) => (
            <li>
              <Astro.self
                blocks={items}
                lang={lang}
                eagerVideoId={eagerVideoId}
                eagerImage={eagerImage}
              />
            </li>
          ))}
        </List>
      );
    }
    if (block.type === 'contact-row')
      return <ContactRow cells={block.cells} border={block.border} />;
    if (block.type === 'group')
      return (
        <div id={block.id} class:list={['content-group', block.variant]}>
          <Astro.self
            blocks={block.children}
            lang={lang}
            eagerVideoId={eagerVideoId}
            eagerImage={eagerImage}
          />
        </div>
      );
    if (block.type === 'paragraph')
      return (
        <p id={block.id} class:list={['content-paragraph', block.variant]}>
          <InlineContent content={block.content} />
        </p>
      );
    if (block.type === 'heading') {
      const Heading = block.rank === 3 ? 'h3' : 'h2';
      return (
        <Heading
          id={block.id}
          class:list={[
            'content-heading',
            block.variant,
            { flush: block.flush, compact: block.compact },
          ]}
        >
          <InlineContent content={block.content} />
        </Heading>
      );
    }
    if (block.type === 'bullet')
      return (
        <div
          id={block.id}
          class:list={['content-bullet', block.variant, { small: block.small }]}
        >
          {block.icon &&
            (block.variant === 'check' ? (
              <Icon name="check" />
            ) : (
              <span class="bullet-icon" aria-hidden="true" />
            ))}
          <div
            style={`--label-span:${block.labelSpan || 1};--small-label-span:${block.smallLabelSpan || 1}`}
          >
            <InlineContent content={block.content} />
          </div>
        </div>
      );
    if (block.type === 'image')
      return (
        <ResponsiveImage
          class={`content-image ${block.variant}`}
          image={block.image}
          alt={block.alt}
          eager={block.image === eagerImage}
          sizes="(min-width:992px) 55vw, 90vw"
        />
      );
    if (block.type === 'anchor')
      return (
        <div
          id={block.id}
          class:list={['content-anchor', block.variant]}
          aria-hidden="true"
        />
      );
    if (block.type === 'faq')
      return (
        <FAQ
          items={[
            { question: block.question, answer: [], richAnswer: block.answer },
          ]}
          variant="detail"
        />
      );
    if (block.type === 'comparison') return <GalleryComparison {...block} />;
    if (block.type === 'youtube')
      return (
        <YouTubeVideo
          {...block}
          lang={lang}
          eager={block.videoId === eagerVideoId}
        />
      );
    if (block.type === 'map') return <MapPanel src={block.src} />;
    if (block.type === 'review-source') return <ReviewSource {...block} />;
    return null;
  })
}
<style>
  .content-list {
    padding-left: 1.5em;
    margin-block: 16px;
    font-size: 18px;
    line-height: 1.4;
  }
  .content-list li {
    margin-block: 8px;
  }
  .content-paragraph {
    margin: 10px 0 20px;
    font-size: 18px;
    line-height: 140%;
    font-weight: 400;
  }
  .content-paragraph.small {
    font-size: 16px;
  }
  .content-heading {
    margin: 80px 0 20px;
    font-size: 34px;
    line-height: 120%;
    font-weight: 600;
    color: #000;
  }
  .content-heading.subsection {
    margin-top: 40px;
    font-size: 28px;
  }
  .content-heading.gallery-section {
    margin-top: 60px;
    font-weight: 500;
  }
  .content-paragraph.caption {
    margin: 16px 0 60px;
  }
  .content-paragraph.price {
    margin-top: 0;
    font-size: 22px;
    font-weight: 500;
    line-height: 120%;
  }
  .content-heading.contact {
    margin-top: 20px;
    font-size: 26px;
    font-weight: 500;
  }
  .content-heading.review {
    margin: 20px 0 0;
    font-size: 24px;
    font-weight: 500;
  }
  .content-heading.flush {
    margin-top: 0;
  }
  .content-heading.compact {
    margin-bottom: 0;
  }
  .content-paragraph.price-list {
    margin: 0;
    font-size: 22px;
    line-height: 120%;
    font-weight: 500;
  }
  .content-paragraph.price-prefix {
    margin: 10px 0 0;
  }
  .content-group.price-amount {
    border-left: 1px solid var(--color-border);
    padding-left: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
  }
  .content-bullet {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: flex-start;
    gap: 16px;
    padding: 10px 0;
    color: #000;
    font-size: 18px;
    font-weight: 500;
    line-height: 140%;
  }
  .content-bullet :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 4px;
  }
  .content-bullet > div {
    grid-column: span var(--label-span, 1);
  }
  .content-bullet.small {
    font-size: 16px;
  }
  .bullet-icon {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 5px;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    padding: 2px;
    background: var(--color-accent);
    background-clip: content-box;
  }
  .content-bullet.contact {
    border-bottom: 1px solid var(--color-border);
    padding: 8px 0;
  }
  .content-group.callout {
    background: white;
    border-radius: var(--radius);
    padding: 20px;
  }
  .content-group.contact-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: var(--radius);
    margin-bottom: 40px;
    padding: 10px 30px 30px;
  }
  .content-group.price-card {
    background: white;
    border-radius: var(--radius);
    margin-bottom: 40px;
    padding: 30px;
  }
  .price-card :global(.content-heading.flush) {
    font-size: 26px;
  }
  .content-group.price-row,
  .content-group.price-row-borderless {
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .content-group.price-row-borderless {
    border-top: 0;
  }
  .content-group.review {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 40px;
  }
  .content-group.contact-address {
    padding-bottom: 40px;
  }
  .content-paragraph.review-source {
    font-size: 14px;
  }
  :global(.content-image.portrait) {
    display: inline-block;
    vertical-align: middle;
    border-radius: var(--radius);
    margin: 10px 0 20px;
  }
  .content-anchor {
    scroll-margin-top: calc(var(--header-height) + 60px);
  }
  .content-anchor.space {
    height: 40px;
  }
  .content-anchor.section-offset {
    height: 90px;
    scroll-margin-top: 140px;
  }
  @media screen and (max-width: 991px) {
    .content-paragraph.price {
      margin-bottom: 10px;
    }
    .content-anchor.section-offset {
      height: 70px;
      scroll-margin-top: 120px;
    }
    .content-heading.subsection {
      margin-bottom: 10px;
    }
  }
  @media screen and (max-width: 479px) {
    .content-bullet > div {
      grid-column: span var(--small-label-span, 1);
    }
    .content-paragraph.price {
      font-size: 6.6vw;
    }
    .content-group.price-amount {
      border: 0;
      padding: 0;
      flex-direction: row;
      justify-content: flex-start;
      align-items: flex-end;
    }
    .content-paragraph.price-list {
      padding-left: 10px;
      font-size: 8vw;
      line-height: 1;
    }
    .content-bullet.check :global(svg) {
      width: 1.2rem;
      height: 1.2rem;
    }
    .content-anchor.section-offset {
      height: 60px;
    }
    .content-heading {
      font-size: 30px;
    }
    .content-heading.subsection {
      font-size: 24px;
    }
    .content-heading.contact {
      font-size: 7vw;
    }
    .content-bullet {
      gap: 10px;
      font-size: 16px;
    }
    .content-group.price-row,
    .content-group.price-row-borderless {
      grid-template-columns: 1fr;
      padding-top: 0;
    }
    .content-group.price-card,
    .content-group.contact-card {
      padding-inline: 20px;
    }
  }
</style>
