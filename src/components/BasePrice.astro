---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

{' '}<span class="base-price">{text}</span>

<style>
  .base-price {
    display: block;
    margin-block-start: 0.375rem;
    color: #344750;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }
</style>
