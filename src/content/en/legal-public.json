              ],
              "rank": 4,
              "flush": false
            },
            {
              "type": "paragraph",
              "variant": "body",
              "content": [
                {
                  "kind": "text",
                  "text": "The data subject has the right to file a Request for determination of violation of rights to the Personal Data Protection Agency."
                }
              ]
            }
          ],
          [
            {
              "type": "heading",
              "variant": "subsection",
              "content": [
                {
                  "kind": "text",
                  "text": "\n                                        "
                },
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "Revocation of consent"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": "\n                                        "
                }
