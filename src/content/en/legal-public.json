              "rank": 4,
              "flush": false
            },
            {
              "type": "paragraph",
              "variant": "body",
              "content": [
                {
                  "kind": "text",
                  "text": "The Data subject may, at any time, withdraw his consent for the collection and processing of personal data not covered by this Rules."
                }
