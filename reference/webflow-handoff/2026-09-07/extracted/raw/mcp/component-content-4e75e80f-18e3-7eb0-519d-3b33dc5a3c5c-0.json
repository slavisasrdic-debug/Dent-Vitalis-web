            "attributes": {}
          },
          {
            "type": "text",
            "id": "4e75e80f-18e3-7eb0-519d-3b33dc5a3c79",
            "text": {
              "html": "<a class=\"medjunaslov-h3\" href=\"/informazioni/trasporto\">Il nostro trasporto</a>",
              "text": "Il nostro trasporto"
