          {
            "type": "text",
            "id": "4e75e80f-18e3-7eb0-519d-3b33dc5a3c6a",
            "text": {
              "html": "<a class=\"medjunaslov-h3\" href=\"/informazioni/prima-visita-gratuita\">Prima visita gratuita</a>",
              "text": "Prima visita gratuita"
            },
            "attributes": {}
          },
          {
            "type": "text",
            "id": "4e75e80f-18e3-7eb0-519d-3b33dc5a3c6c",
            "text": {
              "html": "<p class=\"large-paragraph\">Dopo la prima visita ti forniremo tutte le informazioni sulle ulteriori agevolazioni e vantaggi disponibili.</p>",
              "text": "Dopo la prima visita ti forniremo tutte le informazioni sulle ulteriori agevolazioni e vantaggi disponibili."
