                                      "element": "1cdea7b8-f3a0-d7f3-f8b1-86b770f7004d"
                                    },
                                    "type": "String",
                                    "textContent": "Passaporto dell’impianto"
                                  }
                                ]
                              },
                              {
                                "id": {
                                  "component": "695e1eeeb10c5fb8eeaba893",
                                  "element": "1cdea7b8-f3a0-d7f3-f8b1-86b770f70050"
                                },
                                "type": "Block",
                                "styleNames": [
                                  "odlomak"
                                ],
                                "settings": {
                                  "tag": "div",
                                  "visibility": true,
                                  "block": {
                                    "tag": "div"
                                  }
                                },
                                "children": [
                                  {
                                    "id": {
                                      "component": "695e1eeeb10c5fb8eeaba893",
                                      "element": "1cdea7b8-f3a0-d7f3-f8b1-86b770f70051"
                                    },
                                    "type": "Paragraph",
                                    "styleNames": [
                                      "Large Paragraph"
                                    ],
                                    "settings": {
                                      "visibility": true
                                    },
                                    "children": [
                                      {
                                        "id": {
                                          "component": "695e1eeeb10c5fb8eeaba893",
                                          "element": "1cdea7b8-f3a0-d7f3-f8b1-86b770f70052"
                                        },
                                        "type": "String",
                                        "textContent": "Insieme alla garanzia, ogni paziente riceve anche un passaporto degli impianti, un documento che riporta in modo preciso tutti i dati relativi agli impianti inseriti, tra cui produttore, modello e caratteristiche di ciascun impianto.\n\nQuesta documentazione è particolarmente importante per chi vive all’estero o viaggia frequentemente. In caso di necessità o di eventuali problemi, qualsiasi implantologo può consultare i dati relativi agli impianti inseriti e intervenire in modo adeguato, anche quando il paziente si trova lontano dalla nostra clinica.\n\nIl passaporto è inoltre importante per eventuali esigenze future. Se, dopo diversi anni, fosse necessario sostituire o rifare la protesi sugli impianti esistenti, il paziente potrà rivolgersi anche a un altro dentista o implantologo, disponendo già di tutte le informazioni necessarie per procedere.\n\nRiteniamo che ogni paziente debba avere pieno accesso alle informazioni relative alle proprie cure. Per questo consegniamo tutta la documentazione sugli impianti inseriti, affinché possa conservarla e utilizzarla in qualsiasi momento e ovunque si trovi."
                                      }
                                    ]
                                  }
                                ]
                              }
