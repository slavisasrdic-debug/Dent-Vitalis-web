            "id": "dca34dd2-4bec-05d2-81b1-f6dc3d1c5dd5",
            "text": {
              "html": "<p class=\"podnaslov-detaljna\">Scegli la soluzione più adatta alle tue esigenze.</p>",
              "text": "Scegli la soluzione più adatta alle tue esigenze."
            },
            "attributes": {}
          },
          {
            "type": "component-instance",
            "id": "01415f8e-f1dc-065f-6696-5928ab24123a",
