          },
          {
            "type": "text",
            "id": "16d7fccc-bcba-2654-d5a1-45df58a85388",
            "text": {
              "html": "<p class=\"podnaslov-detaljna\">Siamo a Rijeka (Fiume), in Croazia, a soli 60 km da Trieste. Trasferimento gratuito.</p>",
              "text": "Siamo a Rijeka (Fiume), in Croazia, a soli 60 km da Trieste. Trasferimento gratuito."
            },
            "attributes": {}
          },
          {
            "type": "component-instance",
            "id": "dc34db01-7c8b-9691-e7b8-29f75196bc64",
            "componentId": "12779da6-57f4-1edc-0b0f-c14d7c69e8c1",
