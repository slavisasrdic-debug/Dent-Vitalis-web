# DentVitalis — pregledni .htaccess, 2026-10-04
# SEO PRIJEDLOG ODOBREN; talijanska galerija uskladjena na /galleria.
# Zadrzana postojeca/odobrena odredista; nema novih medicinskih spajanja.
# Query parametri (UTM, gclid itd.) ostaju sacuvani.

# 1. OSNOVNE POSTAVKE — novi HTML ima prednost nad starim PHP-om
Options -Indexes
RewriteEngine On
DirectoryIndex index.html index.php
RewriteOptions AllowNoSlash
<If "%{REQUEST_URI} =~ m#^(/[a-z0-9/-]+?)/?$# && -f '%{DOCUMENT_ROOT}/_pages$1.html' || %{REQUEST_URI} =~ m#^/(?:hr/hvala-akcija|si/hvala-akcija)/?$#">
DirectorySlash Off
</If>

# 2. HTTPS + WWW — 308 cuva metodu i tijelo zahtjeva forme
RewriteCond %{HTTP_HOST} ^(?:www\.)?dentvitalis\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.dentvitalis\.com$
RewriteCond %{THE_REQUEST} \s(/[^?\s]*)
RewriteRule ^ https://www.dentvitalis.com%1 [R=308,L,NE]

# 3. PHP FORME I TOKENI — uvijek backend; bez cachea i indeksiranja
RewriteRule ^(?:send|gct|send-sconto|form-tokens)/?$ index.php [END]
<If "%{THE_REQUEST} =~ m#\s/(?:send|gct|send-sconto|form-tokens)/?(?:[?\s])#">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header always set Cache-Control "private, no-store, max-age=0"
    Header always set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</If>

# 4. TRAJNE PROMJENE URL-OVA — ranije odobrene 301
RewriteRule ^domande-e-risposte/?$ https://www.dentvitalis.com/galleria [R=301,L,NE]
RewriteRule ^en/about-us/?$ https://www.dentvitalis.com/en/about [R=301,L,NE]
RewriteRule ^alloggio/?$ https://www.dentvitalis.com/informazioni/alloggio [R=301,L,NE]
RewriteRule ^hr/technologija/?$ https://www.dentvitalis.com/hr/materijali-i-oprema [R=301,L,NE]
RewriteRule ^hr/keramicki-most-na-prirodnim-zubima/?$ https://www.dentvitalis.com/hr/krunice-ljuskice-mostovi-i-proteze [R=301,L,NE]
RewriteRule ^hr/testimonials-edita-karadole-glumica/?$ https://www.dentvitalis.com/hr/iskustva-pacijenata [R=301,L,NE]
RewriteRule ^hr/testimonials-zoran-roje-sportski-direktor/?$ https://www.dentvitalis.com/hr/iskustva-pacijenata [R=301,L,NE]
RewriteRule ^de/testimonials/?$ https://www.dentvitalis.com/de/erfahrungen-unserer-patienten [R=301,L,NE]
RewriteRule ^si/testimonials/?$ https://www.dentvitalis.com/si/izkusnje-pacientov [R=301,L,NE]

# 5. DODATNE JASNE ZAMJENE — osam pravila odobrenih od vlasnika i SEO mastera
# Odobreno 2026-10-04; nema novih medicinskih spajanja.
RewriteRule ^prima-visita/?$ https://www.dentvitalis.com/informazioni/prima-visita-gratuita [R=301,L,NE]
RewriteRule ^de/die-erste-kontrolle/?$ https://www.dentvitalis.com/de/kostenlose-erstuntersuchung [R=301,L,NE]
RewriteRule ^hr/testimonials/?$ https://www.dentvitalis.com/hr/iskustva-pacijenata [R=301,L,NE]
RewriteRule ^garanzie/?$ https://www.dentvitalis.com/informazioni/garanzie [R=301,L,NE]
RewriteRule ^pagamento/?$ https://www.dentvitalis.com/informazioni/pagamento-flessibile [R=301,L,NE]
RewriteRule ^en/manner-of-payment/?$ https://www.dentvitalis.com/en/payment [R=301,L,NE]
RewriteRule ^trasferta/?$ https://www.dentvitalis.com/informazioni/trasporto [R=301,L,NE]
RewriteRule ^laboratorio-odontotecnico/?$ https://www.dentvitalis.com/su-di-noi/laboratorio-odontotecnico [R=301,L,NE]

